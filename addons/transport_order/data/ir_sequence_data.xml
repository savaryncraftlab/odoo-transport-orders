<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Order numbers like TO/2026/00001; the counter restarts every year (use_date_range). -->
    <record id="seq_transport_order" model="ir.sequence">
        <field name="name">Transport Order</field>
        <field name="code">transport.order</field>
        <field name="prefix">TO/%(range_year)s/</field>
        <field name="padding">5</field>
        <field name="use_date_range" eval="True"/>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
