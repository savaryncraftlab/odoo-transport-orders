<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List: one line per order, totals in the footer, red margin when it is negative. -->
    <record id="transport_order_view_list" model="ir.ui.view">
        <field name="name">transport.order.list</field>
        <field name="model">transport.order</field>
        <field name="arch" type="xml">
            <list string="Transport Orders" sample="1"
                  decoration-muted="state == 'cancelled'">
                <field name="name" decoration-bf="1"/>
                <field name="loading_date"/>
                <field name="unloading_date" optional="show"/>
                <field name="route"/>
                <field name="client_id"/>
                <field name="client_ref" optional="hide"/>
                <field name="carrier_id"/>
                <field name="user_id" widget="many2one_avatar_user" optional="show"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="client_price" sum="Total" optional="show"/>
                <field name="carrier_price" sum="Total" optional="show"/>
                <field name="margin" sum="Total" decoration-danger="margin &lt; 0" decoration-bf="1"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state in ('confirmed', 'in_transit')"
                       decoration-success="state == 'delivered'"
                       decoration-muted="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="transport_order_view_form" model="ir.ui.view">
        <field name="name">transport.order.form</field>
        <field name="model">transport.order</field>
        <field name="arch" type="xml">
            <form string="Transport Order">
                <header>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_start_transit" string="Loaded, In Transit" type="object" class="btn-primary"
                            invisible="state != 'confirmed'"/>
                    <button name="action_deliver" string="Delivered" type="object" class="btn-primary"
                            invisible="state != 'in_transit'"/>
                    <button name="%(action_report_carrier_order)d" string="Print Carrier Order" type="action"
                            invisible="state in ('draft', 'cancelled') or not carrier_id"/>
                    <button name="action_cancel" string="Cancel Order" type="object"
                            invisible="state in ('delivered', 'cancelled')"
                            confirm="Cancel this order? The carrier has to be informed separately."/>
                    <button name="action_reset_to_draft" string="Reopen as Draft" type="object"
                            invisible="state != 'cancelled'"
                            groups="transport_order.group_transport_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,in_transit,delivered"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Cancelled" bg_color="text-bg-danger"
                            invisible="state != 'cancelled'"/>
                    <div class="alert alert-danger" role="alert" invisible="margin &gt;= 0">
                        Negative margin: the carrier costs more than the client pays.
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Client">
                            <field name="client_id" readonly="state in ('delivered', 'cancelled')"/>
                            <field name="client_ref" readonly="state in ('delivered', 'cancelled')"/>
                            <field name="client_price" readonly="state in ('delivered', 'cancelled')"/>
                        </group>
                        <group string="Carrier">
                            <field name="carrier_id" readonly="state in ('delivered', 'cancelled')"
                                   context="{'default_is_carrier': True, 'default_is_company': True}"/>
                            <field name="carrier_price" readonly="state in ('delivered', 'cancelled')"/>
                            <field name="margin" decoration-danger="margin &lt; 0" decoration-bf="1"/>
                            <field name="margin_ratio" widget="percentage" decoration-danger="margin &lt; 0"/>
                        </group>
                        <group string="Planning">
                            <field name="loading_date"/>
                            <field name="unloading_date"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="currency_id" options="{'no_create': True}"
                                   readonly="state in ('delivered', 'cancelled')"/>
                            <field name="company_id" groups="base.group_multi_company"
                                   readonly="state in ('delivered', 'cancelled')"/>
                        </group>
                        <group string="Cargo">
                            <field name="vehicle_type" readonly="state in ('delivered', 'cancelled')"/>
                            <field name="cargo_description" readonly="state in ('delivered', 'cancelled')"/>
                            <field name="weight_kg" readonly="state in ('delivered', 'cancelled')"/>
                            <field name="is_adr" readonly="state in ('delivered', 'cancelled')"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Route" name="route">
                            <field name="stop_ids" readonly="state in ('delivered', 'cancelled')">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="stop_type"/>
                                    <field name="date"/>
                                    <field name="time_window" optional="show"/>
                                    <field name="place_name"/>
                                    <field name="street" optional="show"/>
                                    <field name="zip"/>
                                    <field name="city"/>
                                    <field name="country_id" options="{'no_create': True}"/>
                                    <field name="note" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Internal Notes" name="notes">
                            <field name="notes" placeholder="For the office only. Not printed on the carrier order."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Kanban board by status. Cards cannot be dragged: a status changes only through the buttons. -->
    <record id="transport_order_view_kanban" model="ir.ui.view">
        <field name="name">transport.order.kanban</field>
        <field name="model">transport.order</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1" quick_create="false"
                    records_draggable="false" group_create="false" group_delete="false" group_edit="false">
                <field name="currency_id"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between">
                            <field name="name" class="fw-bold"/>
                            <span t-if="record.carrier_id.raw_value"
                                  t-att-class="record.margin.raw_value &lt; 0 ? 'text-danger fw-bold' : ''">
                                <field name="margin" widget="monetary"/>
                            </span>
                        </div>
                        <field name="route" class="text-truncate"/>
                        <field name="client_id"/>
                        <field name="carrier_id" class="text-muted"/>
                        <div class="d-flex justify-content-between align-items-center mt-1">
                            <field name="loading_date"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="transport_order_view_search" model="ir.ui.view">
        <field name="name">transport.order.search</field>
        <field name="model">transport.order</field>
        <field name="arch" type="xml">
            <search string="Transport Orders">
                <field name="name"/>
                <field name="client_id"/>
                <field name="carrier_id"/>
                <field name="client_ref"/>
                <field name="route"/>
                <filter string="My Orders" name="my_orders" domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="In Progress" name="in_progress" domain="[('state', 'in', ('confirmed', 'in_transit'))]"/>
                <filter string="Delivered" name="delivered" domain="[('state', '=', 'delivered')]"/>
                <separator/>
                <filter string="Negative Margin" name="negative_margin" domain="[('margin', '&lt;', 0)]"/>
                <filter string="No Carrier Yet" name="no_carrier"
                        domain="[('carrier_id', '=', False), ('state', '!=', 'cancelled')]"/>
                <separator/>
                <filter string="Loading Date" name="filter_loading_date" date="loading_date"/>
                <group>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Client" name="group_client" context="{'group_by': 'client_id'}"/>
                    <filter string="Carrier" name="group_carrier" context="{'group_by': 'carrier_id'}"/>
                    <filter string="Dispatcher" name="group_user" context="{'group_by': 'user_id'}"/>
                    <filter string="Loading Month" name="group_loading_month" context="{'group_by': 'loading_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="transport_order_view_pivot" model="ir.ui.view">
        <field name="name">transport.order.pivot</field>
        <field name="model">transport.order</field>
        <field name="arch" type="xml">
            <pivot string="Margin Analysis" sample="1">
                <field name="carrier_id" type="row"/>
                <field name="loading_date" interval="month" type="col"/>
                <field name="client_price" type="measure"/>
                <field name="carrier_price" type="measure"/>
                <field name="margin" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="transport_order_view_graph" model="ir.ui.view">
        <field name="name">transport.order.graph</field>
        <field name="model">transport.order</field>
        <field name="arch" type="xml">
            <graph string="Margin by Month" type="bar" sample="1">
                <field name="loading_date" interval="month"/>
                <field name="margin" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="transport_order_action" model="ir.actions.act_window">
        <field name="name">Transport Orders</field>
        <field name="res_model">transport.order</field>
        <field name="view_mode">list,kanban,form,pivot,graph</field>
        <field name="search_view_id" ref="transport_order_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first transport order</p>
            <p>Add the client, the route stops and the carrier, then confirm the order.</p>
        </field>
    </record>

    <record id="transport_order_action_analysis" model="ir.actions.act_window">
        <field name="name">Margin Analysis</field>
        <field name="res_model">transport.order</field>
        <field name="view_mode">pivot,graph,list,form</field>
        <field name="search_view_id" ref="transport_order_view_search"/>
        <!-- Only orders with agreed prices on both sides: drafts have no real margin yet. -->
        <field name="domain">[('state', 'in', ('confirmed', 'in_transit', 'delivered'))]</field>
    </record>
</odoo>
