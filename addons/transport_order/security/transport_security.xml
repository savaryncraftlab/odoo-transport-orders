<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Odoo 19: groups belong to a "privilege", which is shown as one selector on the user form. -->
    <record id="res_groups_privilege_transport" model="res.groups.privilege">
        <field name="name">Transport</field>
        <field name="sequence">50</field>
        <field name="category_id" ref="base.module_category_supply_chain"/>
    </record>

    <record id="group_transport_user" model="res.groups">
        <field name="name">Dispatcher</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_transport"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <record id="group_transport_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_transport"/>
        <field name="implied_ids" eval="[Command.link(ref('group_transport_user'))]"/>
        <field name="user_ids" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
    </record>

    <data noupdate="1">
        <!-- Multi-company: a user only sees orders of the companies selected in the company switcher. -->
        <record id="transport_order_rule_company" model="ir.rule">
            <field name="name">Transport orders: allowed companies</field>
            <field name="model_id" ref="model_transport_order"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="transport_order_stop_rule_company" model="ir.rule">
            <field name="name">Transport order stops: allowed companies</field>
            <field name="model_id" ref="model_transport_order_stop"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
